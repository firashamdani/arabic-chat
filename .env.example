# ============ الإعدادات العامة ============
NODE_ENV=development
PORT=3000
APP_NAME=شات العرب
APP_URL=http://localhost:3000

# ============ قاعدة البيانات (MongoDB Atlas - مجاني) ============
# من Atlas: Database -> Connect -> Drivers -> انسخ رابط الاتصال
MONGODB_URI=mongodb://127.0.0.1:27017/arabic_chat

# ============ الأمان ============
# غيّره إلى نص عشوائي طويل (مثال: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ============ حساب الأدمن (يُنشأ تلقائياً عند أول تشغيل) ============
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
ADMIN_DISPLAY_NAME=المدير العام

# ============ Realtime: Pusher Channels (مجاني) ============
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu

# ============ رفع الصور والملفات: Cloudinary (مجاني) ============
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# ============ حد التسجيل المفتوح (اتركه true للسماح بالتسجيل العام) ============
ALLOW_SIGNUP=true
